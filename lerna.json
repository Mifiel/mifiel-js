{
  "npmClient": "pnpm",
  "command": {
    "version": {
      "conventionalCommits": true,
      "includeMergedTags": true,
      "message": "chore(release): :rocket: bump versions"
    }
  },
  "ignoreChanges": ["**/CHANGELOG.md", "**/*.md"],
  "packages": ["packages/*"],
  "version": "independent",
  "$schema": "node_modules/lerna/schemas/lerna-schema.json"
}
